<Window x:Class="Employee_Task.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Employee_Task"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="2*" />
            <RowDefinition Height="2*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label 
                Content="User Name"
               FontSize="25" FontStyle="Italic"
               FontWeight="Bold"/>
           <TextBox 
                Margin="100,0,0,0" x:Name="txt_name"       
                Width="300" Height="50"
                BorderBrush="Black"
                BorderThickness="2"
               FontSize="20"
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal">
            <Label Content="Password"
                   FontSize="25" 
                   FontStyle="Italic"
                   FontWeight="Bold"/>
            <PasswordBox Margin="100,0,0,0"
                         x:Name="txt_pass"
                         Width="300" Height="50"
                         BorderBrush="Black"
                         BorderThickness="2"
                         FontSize="20" 
                         VerticalAlignment="Center" 
                         HorizontalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Row="4" 
                Width="250" 
                Height="50"
                FontSize="30"
                Content="Login"
                FontWeight="Bold"
                FontStyle="Italic"
                BorderBrush="Black"
                BorderThickness="3"
                Background="White" Click="Button_Click"/>
    </Grid>
</Window>
