<Window x:Class="Employee_Task.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Employee_Task"
        mc:Ignorable="d"
        Title="ManagerWindow" Height="750" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="300"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"> 
            <Label 
                Content="User Managment Page"
                FontSize="18"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0"
                Content="TaskId:"
                FontSize="25"
                 FontWeight="SemiBold"
                Width="100"
                HorizontalAlignment="Left"/>
            <TextBox  
                x:Name="txt_taskId"
                Grid.Column="0"
                Width="150"
                Height="50"
                BorderBrush="Black"
                BorderThickness="3"
                Margin="0,-40,0,0"
                FontSize="18"/>
            <Label Grid.Column="1"
                Content="Status:"
                FontSize="25"
                 FontWeight="SemiBold"
                Width="100"
                HorizontalAlignment="Left"/>
            <ComboBox  
                x:Name="cmb_status"
                Grid.Column="1"
                Width="200"
                Height="50"
                BorderBrush="Black"
                BorderThickness="3"
                Margin="0,-40,0,0"
                FontSize="18"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0"
                Content="Title:"
                FontSize="25"
                 FontWeight="SemiBold"
                Width="100"
                HorizontalAlignment="Left"/>
            <TextBox
                x:Name="txt_title"
                Grid.Column="0"
                Width="150"
                Height="50"
                BorderBrush="Black"
                BorderThickness="3"
                Margin="0,-40,0,0"
                FontSize="18"/>
            <Label Grid.Column="1"
                Content="Employee Name:"
                FontSize="25"
                 FontWeight="SemiBold"
                Width="200"
                HorizontalAlignment="Left"/>
            <TextBox
               x:Name="txt_employee_name"
                Grid.Column="1"
                Width="150"
                Height="50"
                BorderBrush="Black"
                BorderThickness="3"
                Margin="230,-40,0,0"
                FontSize="18"/>
        </Grid>
        <Grid Grid.Row="3">
          <Label 
               Grid.Column="1"
               Content="Description:"
               FontSize="25"
                FontWeight="SemiBold"
                Width="200"
                HorizontalAlignment="Left"/>
          <TextBox
                  x:Name="txt_Description"
                  Width="250"
                  Height="50"
                  BorderBrush="Black"
                 BorderThickness="3"
                  Margin="-250,-40,0,0"
                 FontSize="18"/>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button 
                Grid.Column="0"
                x:Name="btn_add"
                Width="150"
                Height="60"
                Content="Add"
                FontSize="25"
                FontWeight="Bold"
                BorderBrush="Black"
                BorderThickness="4"
                Background="White" Click="btn_add_Click"/>
            <Button 
                Grid.Column="1"
                x:Name="btn_edit"
                Width="150"
                Height="60"
                Content="Edit"
                FontSize="25"
                FontWeight="Bold"
                BorderBrush="Black"
                BorderThickness="4"
                Background="White" Click="btn_edit_Click"/>
            <Button 
                Grid.Column="2"
                x:Name="btn_delete"
                Width="150"
                Height="60"
                Content="Delete"
                FontSize="25"
                FontWeight="Bold"
                BorderBrush="Black"
                BorderThickness="4"
                Background="White" Click="btn_delete_Click"/>
            </Grid>
             <Grid Grid.Row="5">
              <DataGrid  
               x:Name="data_grid"
                 Margin="10"
                 BorderBrush="Black"
                 BorderThickness="3"
                 AutoGenerateColumns="True"
                 IsReadOnly="True"/>
        </Grid>
    </Grid>
</Window>
